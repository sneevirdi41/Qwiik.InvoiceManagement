{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=QwiikInvoiceManagement;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Authentication": {
    "Mode": "Jwt",
    "Jwt": {
      "Authority": "",
      "Audience": "qwiik-invoice-api",
      "ValidIssuer": ""
    }
  },
  "Database": {
    "MigrateAndSeedOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
